QUESTION 2:
Discount rules:
- Less than $100: 0% discount
- $100 to $500: 10% discount
- More than $500: 20% discount
VB code:
For i As Integer = 1 To 3
    Dim total As Double
    Dim discount As Double
    Dim finalAmount As Double
    total = CDbl(InputBox("Enter total amount for customer " & i))
    If total < 100 Then
        discount = 0
    ElseIf total <= 500 Then
        discount = total * 0.1
    Else
        discount = total * 0.2
    End If
    finalAmount = total - discount
    MessageBox.Show("Customer " & i & vbCrLf &
                    "Total: $" & total & vbCrLf &
                    "Discount: $" & discount & vbCrLf &
                    "Final Amount: $" & finalAmount)
Next
