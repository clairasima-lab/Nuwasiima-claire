Calculation and validation code:
Private Sub btnCalculate_Click(sender As Object, e As EventArgs) Handles btnCalculate.Click
    Dim ict As Double
    Dim vb As Double
    Dim research As Double
    Dim cyber As Double
    Dim total As Double
    Dim average As Double
    Dim grade As String
    Dim status As String
    If txtName.Text = "" Or txtICT.Text = "" Or
       txtVB.Text = "" Or txtResearch.Text = "" Or
       txtCyber.Text = "" Then
        MessageBox.Show("Please fill in all fields.")
        Exit Sub
    End If
    If Not Double.TryParse(txtICT.Text, ict) Or
       Not Double.TryParse(txtVB.Text, vb) Or
       Not Double.TryParse(txtResearch.Text, research) Or
       Not Double.TryParse(txtCyber.Text, cyber) Then
        MessageBox.Show("Please enter numeric marks.")
        Exit Sub
    End If
    If ict < 0 Or ict > 100 Or vb < 0 Or vb > 100 Or
       research < 0 Or research > 100 Or cyber < 0 Or cyber > 100 Then
        MessageBox.Show("Marks must be between 0 and 100.")
        Exit Sub
    End If
    total = ict + vb + research + cyber
    average = total / 4
    If average >= 90 Then
        grade = "A"
    ElseIf average >= 80 Then
        grade = "B"
    ElseIf average >= 70 Then
        grade = "C"
    ElseIf average >= 60 Then
        grade = "D"
    Else
        grade = "F"
    End If
    If average >= 60 Then
        status = "PASS"
    Else
        status = "FAIL"
    End If
    lblResult.Text = "Student Name: " & txtName.Text & vbCrLf &
                     "ICT: " & ict & vbCrLf &
                     "Visual Basic: " & vb & vbCrLf &
                     "Research Methods: " & research & vbCrLf &
                     "Cyber & Computer Law: " & cyber & vbCrLf &
                     "Total: " & total & vbCrLf &
                     "Average: " & average & "%" & vbCrLf &
                     "Overall Grade: " & grade & vbCrLf &
                     "Status: " & status
End Sub
